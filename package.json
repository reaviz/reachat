{
  "name": "reachat",
  "version": "2.1.0-alpha.5",
  "description": "Chat UI for Building LLMs",
  "scripts": {
    "build-storybook": "storybook build",
    "build": "npm run build:js && npm run build:styles && npm run build:docs && npm run rewrite:stories",
    "build:js": "vite build --mode library",
    "build:docs": "node scripts/docs.js",
    "build:styles": "npx @tailwindcss/cli -i ./src/styles/index.css -o ./dist/index.css",
    "lint": "eslint --ext js,ts,tsx",
    "lint:fix": "eslint --ext js,ts,tsx --fix src",
    "lint:prettier": "prettier --loglevel warn --write 'src/**/*.{ts,tsx,js,jsx}'",
    "prettier": "prettier --loglevel warn --write 'src/**/*.{ts,tsx,js,jsx}'",
    "rewrite:stories": "node scripts/stories.cjs",
    "start": "storybook dev -p 9009",
    "test": "vitest --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "prepare": "husky install"
  },
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "dist/index.d.ts",
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    },
    "./docs.json": "./dist/docs.json",
    "./stories/*": "./dist/stories/*",
    "./index.css": "./dist/index.css"
  },
  "browser": "dist/index.js",
  "typings": "dist/index.d.ts",
  "dependencies": {
    "@ai-sdk/openai": "^1.1.9",
    "@floating-ui/react": "^0.27.6",
    "@radix-ui/react-slot": "^1.1.0",
    "date-fns": "^4.1.0",
    "katex": "^0.16.11",
    "mdast-util-find-and-replace": "^3.0.1",
    "motion": "^12.4.2",
    "reablocks": "10.0.0-alpha.4",
    "react-markdown": "^9.0.3",
    "react-syntax-highlighter": "^15.6.1",
    "reakeys": "^2.0.3",
    "rehype-katex": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-youtube": "^1.3.2",
    "unified": "^11.0.5"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.35.0",
    "@storybook/addon-docs": "^9.1.8",
    "@storybook/addon-essentials": "^9.0.0-alpha.12",
    "@storybook/addon-interactions": "^9.0.0-alpha.10",
    "@storybook/addon-mdx-gfm": "^9.0.0-alpha.13",
    "@storybook/addon-storysource": "^9.0.0-alpha.14",
    "@storybook/addon-themes": "^9.1.5",
    "@storybook/manager-api": "^9.0.0-alpha.1",
    "@storybook/preview-api": "^9.0.0-alpha.1",
    "@storybook/react": "^9.1.5",
    "@storybook/react-vite": "^9.1.5",
    "@storybook/theming": "^9.0.0-alpha.1",
    "@tailwindcss/cli": "^4.1.13",
    "@tailwindcss/postcss": "^4.1.13",
    "@tailwindcss/vite": "^4.1.13",
    "@types/classnames": "^2.3.4",
    "@types/node": "^22.18.1",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "^3.2.4",
    "ai": "^4.1.35",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-refresh": "^0.4.22",
    "eslint-plugin-no-relative-import-paths": "^1.6.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-storybook": "^9.1.5",
    "eslint-plugin-unused-imports": "^4.2.0",
    "fast-glob": "^3.3.2",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.6",
    "openai": "^4.84.0",
    "postcss": "^8.4.39",
    "postcss-nested": "^7.0.2",
    "postcss-preset-env": "^10.3.1",
    "prettier": "^3.6.2",
    "react": "^18.3.1",
    "react-docgen-typescript": "^2.2.2",
    "react-dom": "^18.3.1",
    "reaviz-lint-rules": "^1.0.3",
    "rollup-plugin-peer-deps-external": "2.2.4",
    "storybook": "^9.1.5",
    "tailwindcss": "^4.1.13",
    "tw-colors": "^3.3.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "typescript-rewrite-paths": "^1.3.1",
    "vite": "^7.1.5",
    "vite-plugin-checker": "^0.10.3",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-static-copy": "^3.1.2",
    "vite-plugin-svgr": "^4.5.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "none",
    "arrowParens": "avoid",
    "bracketSpacing": true,
    "printWidth": 80
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "prettier --write",
      "git add"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=22",
    "npm": ">=10.8.2"
  }
}
